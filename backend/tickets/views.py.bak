logger = logging.getLogger(__name__)

AI_SERVICE_URL = settings.AI_SERVICE_URL
MAX_AI_REPLIES = 3

TROUBLESHOOTING_TIPS = {
    'NetworkOutage': "Please try restarting your router (unplug for 30 seconds, then plug back in) and check if neighbors are also affected.",
    'SlowSpeed': "Try disconnecting other devices and running a speed test after restarting your router.",
    'Billing': "You can check your latest bill and payment status under 'My Account' in the portal.",
    'Installation': "Our installation team typically responds within 24-48 hours. Please ensure someone is available at the address on file.",
    'Other': "Thank you for reaching out — our support team will review your request shortly.",
}


def get_ai_assistant_user():
    """System account for AI replies. Created once, reused after."""
    from users.models import User
    user, created = User.objects.get_or_create(
        phone_number='00000000000',
        defaults={'role': 'SUPPORT_AGENT', 'username': 'AI Assistant'}
    )
    if created:
        user.set_unusable_password()
        user.save()
    return user


def notify_staff_of_escalation(ticket):
    """Notifies every Manager/Admin that a ticket needs human help."""
    from users.models import User
    from notifications.models import Notification

    staff = User.objects.filter(role__in=['MANAGER', 'ADMIN'])
    Notification.objects.bulk_create([
        Notification(
            recipient=s, ticket=ticket,
            message=f"{ticket.customer.reg_number} needs help on {ticket.ticket_number} — AI could not resolve it."
        )
        for s in staff
    ])
    logger.info(f"Ticket {ticket.ticket_number} escalated to {staff.count()} staff members")


def auto_assign_agent(ticket):
    """
    Assign HIGH/CRITICAL tickets to the least-loaded support agent.
    Why: Urgent tickets shouldn't wait in a queue for manual triage.
    """
    from users.models import User
    if ticket.priority not in ['HIGH', 'CRITICAL']:
        return

    # Find the agent with the fewest active tickets
    agents = User.objects.filter(role='SUPPORT_AGENT').annotate(
        active_count=Count(
            'tickets_assigned_as_agent',
            filter=Q(tickets_assigned_as_agent__status__in=['ASSIGNED', 'IN_PROGRESS'])
        )
    ).order_by('active_count')

    if agents.exists():
        agent = agents.first()
        ticket.assign_agent(agent)
        TicketActivity.objects.create(
            ticket=ticket, actor=None,
            action='auto_assigned',
            details=f"Auto-assigned to {agent.username or agent.reg_number} (least loaded)"
        )
        logger.info(f"Auto-assigned {ticket.ticket_number} to {agent.reg_number}")


def check_recurring_issue(ticket):
    """
    Detect if a customer has 3+ tickets in the same category in 30 days.
    Why: Recurring complaints indicate a systemic issue that needs escalation.
    """
    if not ticket.category:
        return
    thirty_days_ago = timezone.now() - timedelta(days=30)
    recent_count = Ticket.objects.filter(
        customer=ticket.customer,
        category=ticket.category,
        created_at__gte=thirty_days_ago,
    ).count()

    if recent_count >= 3:
        from users.models import User
        from notifications.models import Notification
        managers = User.objects.filter(role__in=['MANAGER', 'ADMIN'])
        Notification.objects.bulk_create([
            Notification(
                recipient=m, ticket=ticket,
                message=f"Recurring issue detected: {ticket.customer.reg_number} has {recent_count} {ticket.category.name} tickets in 30 days."
            )
            for m in managers
        ])
        TicketActivity.objects.create(
            ticket=ticket, actor=None,
            action='recurring_detected',
            details=f"{recent_count} tickets in same category in 30 days"
        )


class TicketCategoryViewSet(viewsets.ModelViewSet):
    queryset = TicketCategory.objects.all()
    serializer_class = TicketCategorySerializer
    permission_classes = [permissions.IsAuthenticated]


class TicketViewSet(viewsets.ModelViewSet):
    serializer_class = TicketSerializer
    permission_classes = [permissions.IsAuthenticated]

    filterset_fields = ['status', 'priority', 'category']
    search_fields = ['ticket_number', 'title', 'description']
    ordering_fields = ['created_at', 'updated_at', 'priority', 'sla_deadline']

    def get_queryset(self):
        user = self.request.user
        base = Ticket.objects.select_related('customer', 'assigned_agent', 'category')

        if user.role == 'CUSTOMER':
            return base.filter(customer=user)
        elif user.role == 'SUPPORT_AGENT':
            return base.filter(assigned_agent=user)
        elif user.role == 'TECHNICIAN':
            return base.filter(assigned_technician=user)
        elif user.role in ['MANAGER', 'ADMIN']:
            return base.all()
        return base.none()
    @action(detail=False, methods=['get'], url_path='queue')
    def queue(self, request):
        """
        Staff triage queue: active tickets sorted by SLA urgency.
        Agents see their own + unassigned; Managers/Admins see all.
        Query params: ?status=OPEN (optional filter)
        """
        user = request.user
        if user.role == 'CUSTOMER':
            return Response({'detail': 'Not available for customers.'}, status=403)

        qs = Ticket.objects.select_related('customer', 'assigned_agent', 'category') \
            .exclude(status__in=['RESOLVED', 'CLOSED'])

        # Role-based scope
        if user.role == 'SUPPORT_AGENT':
            qs = qs.filter(Q(assigned_agent=user) | Q(assigned_agent__isnull=True))
        elif user.role == 'TECHNICIAN':
            qs = qs.filter(Q(assigned_technician=user) | Q(assigned_technician__isnull=True))
        # MANAGER / ADMIN see everything (no extra filter)

        # Optional status filter
        status_filter = request.query_params.get('status')
        if status_filter:
            qs = qs.filter(status=status_filter.upper())

        tickets = list(qs)

        # Sort in Python: breached first, then by deadline ascending, then by priority
        priority_rank = {'CRITICAL': 0, 'HIGH': 1, 'MEDIUM': 2, 'LOW': 3}
        now = timezone.now()

        def sort_key(t):
            breached = t.is_sla_breached()
            deadline = t.sla_deadline or now + timedelta(days=365)
            return (
                0 if breached else 1,          # breached tickets first
                deadline,                       # then closest deadline
                priority_rank.get(t.priority, 9),
            )

        tickets.sort(key=sort_key)

        data = TicketSerializer(tickets, many=True).data

        # Enrich each row with SLA metadata the frontend needs
        for row, t in zip(data, tickets):
            deadline = t.sla_deadline
            row['sla_breached'] = t.is_sla_breached()
            if deadline:
                delta = (deadline - now).total_seconds()
                row['sla_seconds_remaining'] = int(delta)
                row['sla_hours_remaining'] = round(delta / 3600, 1)
            else:
                row['sla_seconds_remaining'] = None
                row['sla_hours_remaining'] = None

        return Response({
            'count': len(data),
            'results': data,
        })
    def perform_create(self, serializer):
        ticket = serializer.save(customer=self.request.user)
        ai_data = None

        # Log the creation
        TicketActivity.objects.create(
            ticket=ticket, actor=self.request.user,
            action='created',
            details=f"Ticket created: {ticket.title}"
        )

        try:
            response = httpx.post(
                f"{AI_SERVICE_URL}/ai/analyze",
                json={"text": ticket.description, "customer_id": str(ticket.customer.id)},
                timeout=30.0
            )
            if response.status_code == 200:
                ai_data = response.json()
        except Exception as e:
            logger.error(f"AI service unreachable on ticket creation: {e}")
            ai_data = None

        ai_user = get_ai_assistant_user()

        if ai_data and 'priority' in ai_data:
            ticket.priority = ai_data['priority']
            ticket.ai_reply_count = 1
            ticket.save()

            TicketActivity.objects.create(
                ticket=ticket, actor=ai_user,
                action='ai_analyzed',
                details=f"Category: {ai_data.get('category')}, Priority: {ai_data['priority']}, Confidence: {ai_data.get('confidence', 0)}"
            )

            if ai_data.get('should_escalate', False):
                ticket.escalated = True
                ticket.save()
                TicketComment.objects.create(
                    ticket=ticket, author=ai_user,
                    message=ai_data.get('suggested_reply', 'Our support team will assist you shortly.')
                )
                notify_staff_of_escalation(ticket)
                TicketActivity.objects.create(
                    ticket=ticket, actor=ai_user,
                    action='escalated',
                    details=ai_data.get('escalation_reason', 'AI decided to escalate')
                )
            else:
                category = ai_data.get('category', 'Other')
                tip = TROUBLESHOOTING_TIPS.get(category, TROUBLESHOOTING_TIPS['Other'])
                reply_text = f"{ai_data.get('suggested_reply', '')}\n\nQuick tip: {tip}"
                TicketComment.objects.create(ticket=ticket, author=ai_user, message=reply_text)

                if ai_data['priority'] in ['HIGH', 'CRITICAL']:
                    TicketComment.objects.create(
                        ticket=ticket, author=ai_user,
                        message="This issue has been flagged as urgent. Our support team has been notified."
                    )
                    notify_staff_of_escalation(ticket)
        else:
            TicketComment.objects.create(
                ticket=ticket, author=ai_user,
                message="Thank you for reporting this. Our support team will review your ticket and get back to you shortly."
            )

        # Auto-assign urgent tickets and check for recurring issues
        auto_assign_agent(ticket)
        check_recurring_issue(ticket)

    @action(detail=False, methods=['get'])
    def sla_breaches(self, request):
        """Return all tickets currently breaching SLA (staff only)."""
        if request.user.role not in ['SUPPORT_AGENT', 'MANAGER', 'ADMIN']:
            return Response({'detail': 'Forbidden'}, status=403)
        breached = [t for t in self.get_queryset().exclude(status__in=['RESOLVED', 'CLOSED']) if t.is_sla_breached()]
        serializer = self.get_serializer(breached, many=True)
        return Response(serializer.data)


class TicketCommentViewSet(viewsets.ModelViewSet):
    serializer_class = TicketCommentSerializer
    permission_classes = [permissions.IsAuthenticated]

    def get_queryset(self):
        user = self.request.user
        ticket_id = self.request.query_params.get('ticket')
        base = TicketComment.objects.select_related('author', 'ticket')
        if ticket_id:
            base = base.filter(ticket_id=ticket_id)

        if user.role == 'CUSTOMER':
            return base.filter(ticket__customer=user)
        elif user.role in ['SUPPORT_AGENT', 'TECHNICIAN', 'MANAGER', 'ADMIN']:
            return base.all()
        return base.none()

    def perform_create(self, serializer):
        comment = serializer.save(author=self.request.user)
        ticket = comment.ticket

        # Log the comment activity
        TicketActivity.objects.create(
            ticket=ticket, actor=self.request.user,
            action='comment_added',
            details=f"Comment by {self.request.user.username or self.request.user.reg_number}"
        )

        is_customer_message = (self.request.user == ticket.customer)
        ticket_still_active = ticket.status not in ['RESOLVED', 'CLOSED']

        if not (is_customer_message and ticket_still_active and not ticket.escalated):
            return

        ai_user = get_ai_assistant_user()

        if ticket.ai_reply_count >= MAX_AI_REPLIES:
            ticket.escalated = True
            ticket.save()
            TicketComment.objects.create(
                ticket=ticket, author=ai_user,
                message="I've connected you with our support team — they'll follow up with you shortly."
            )
            notify_staff_of_escalation(ticket)
            TicketActivity.objects.create(
                ticket=ticket, actor=ai_user,
                action='escalated',
                details='AI reply limit reached'
            )
            return

        history = "\n".join(
            f"{c.author.username or 'Customer'}: {c.message}"
            for c in ticket.comments.order_by('created_at')
        )

        try:
            response = httpx.post(
                f"{AI_SERVICE_URL}/ai/analyze",
                json={
                    "text": f"Ticket conversation so far:\n{history}\n\nRespond helpfully to the customer's latest message.",
                    "customer_id": str(ticket.customer.id),
                },
                timeout=30.0
            )
            if response.status_code == 200:
                data = response.json()
                reply = data.get('suggested_reply', "Let me look into that for you.")
                TicketComment.objects.create(ticket=ticket, author=ai_user, message=reply)
                ticket.ai_reply_count += 1
                ticket.save()
            else:
                raise Exception("AI service returned non-200")
        except Exception as e:
            logger.error(f"AI service failed mid-conversation on {ticket.ticket_number}: {e}")
            ticket.escalated = True
            ticket.save()
            TicketComment.objects.create(
                ticket=ticket, author=ai_user,
                message="I'm having trouble processing that right now — I've flagged this for our team to follow up."
            )
            notify_staff_of_escalation(ticket)


class InternalNoteViewSet(viewsets.ModelViewSet):
    serializer_class = InternalNoteSerializer
    permission_classes = [permissions.IsAuthenticated, IsStaffRole]

    def get_queryset(self):
        ticket_id = self.request.query_params.get('ticket')
        base = InternalNote.objects.select_related('author', 'ticket')
        if ticket_id:
            base = base.filter(ticket_id=ticket_id)
        return base.all()

    def perform_create(self, serializer):
        note = serializer.save(author=self.request.user)
        TicketActivity.objects.create(
            ticket=note.ticket, actor=self.request.user,
            action='internal_note_added',
            details=f"Internal note added by {self.request.user.username or self.request.user.reg_number}"
        )


class AttachmentViewSet(viewsets.ModelViewSet):
    serializer_class = AttachmentSerializer
    permission_classes = [permissions.IsAuthenticated]
    parser_classes = [MultiPartParser, FormParser]

    def get_queryset(self):
        user = self.request.user
        ticket_id = self.request.query_params.get('ticket')
        base = Attachment.objects.select_related('uploaded_by', 'ticket')
        if ticket_id:
            base = base.filter(ticket_id=ticket_id)

        if user.role == 'CUSTOMER':
            return base.filter(ticket__customer=user)
        elif user.role in ['SUPPORT_AGENT', 'TECHNICIAN', 'MANAGER', 'ADMIN']:
            return base.all()
        return base.none()

    def perform_create(self, serializer):
        serializer.save(uploaded_by=self.request.user)

    @action(detail=True, methods=['get'])
    def download(self, request, pk=None):
        attachment = self.get_object()
        try:
            return FileResponse(
                attachment.file.open('rb'),
                as_attachment=True,
                filename=attachment.file.name.split('/')[-1],
            )
        except FileNotFoundError:
            raise Http404("File not found.")


class TicketRatingViewSet(viewsets.ModelViewSet):
    """
    Customer satisfaction ratings. Only the ticket's customer can rate,
    and only after the ticket is RESOLVED or CLOSED.
    """
    serializer_class = TicketRatingSerializer
    permission_classes = [permissions.IsAuthenticated]

    def get_queryset(self):
        user = self.request.user
        base = TicketRating.objects.select_related('ticket')
        if user.role == 'CUSTOMER':
            return base.filter(ticket__customer=user)
        return base.all()

    def perform_create(self, serializer):
        ticket = serializer.validated_data['ticket']
        if ticket.customer != self.request.user:
            raise permissions.PermissionDenied("You can only rate your own tickets.")
        if ticket.status not in ['RESOLVED', 'CLOSED']:
            raise serializers.ValidationError("Ticket must be resolved before rating.")
        rating = serializer.save()
        TicketActivity.objects.create(
            ticket=ticket, actor=self.request.user,
            action='rated',
            details=f"Customer rated {rating.score}/5"
        )


class TicketActivityViewSet(viewsets.ReadOnlyModelViewSet):
    """
    Read-only audit log of ticket activities.
    Customers see activities for their own tickets, staff see all.
    """
    serializer_class = TicketActivitySerializer
    permission_classes = [permissions.IsAuthenticated]

    def get_queryset(self):
        user = self.request.user
        ticket_id = self.request.query_params.get('ticket')
        base = TicketActivity.objects.select_related('actor', 'ticket')
        if ticket_id:
            base = base.filter(ticket_id=ticket_id)
        if user.role == 'CUSTOMER':
            return base.filter(ticket__customer=user)
        return base.all()


class OutageViewSet(viewsets.ModelViewSet):
    """
    Network outages. Staff creates/manages, everyone can read (including AI agent).
    """
    queryset = Outage.objects.all()
    serializer_class = OutageSerializer
    permission_classes = [permissions.IsAuthenticated]
    filterset_fields = ['status', 'area']

    def get_permissions(self):
        # AI service (and anyone) can read outages; only staff can write/resolve
        if self.action in ['list', 'retrieve']:
            return [permissions.AllowAny()]
        if self.action in ['create', 'update', 'partial_update', 'destroy', 'resolve']:
            return [permissions.IsAuthenticated(), IsStaffRole()]
        return [permissions.IsAuthenticated()]

    def perform_create(self, serializer):
        serializer.save(created_by=self.request.user)

    @action(detail=True, methods=['post'])
    def resolve(self, request, pk=None):
        outage = self.get_object()
        outage.resolve()
        return Response(OutageSerializer(outage).data)


class DashboardView(APIView):
    """Manager/Admin only. Returns aggregated ticket stats in one call."""
    permission_classes = [permissions.IsAuthenticated, IsManagerOrAdmin]

    def get(self, request):
        tickets = Ticket.objects.all()
        today = timezone.now().date()
        today_tickets = tickets.filter(created_at__date=today)
        thirty_days_ago = today - timedelta(days=29)  # inclusive of today = 30 buckets

        status_counts = dict(
            tickets.values_list('status').annotate(count=Count('id')).values_list('status', 'count')
        )
        priority_counts = dict(
            tickets.values_list('priority').annotate(count=Count('id')).values_list('priority', 'count')
        )
        category_counts = list(
            tickets.values('category__name').annotate(count=Count('id')).order_by('-count')[:10]
        )

        # Average resolution time
        closed = tickets.filter(status='CLOSED', closed_at__isnull=False)
        avg_resolution = closed.annotate(
            resolution_time=ExpressionWrapper(
                F('closed_at') - F('created_at'), output_field=DurationField()
            )
        ).aggregate(avg=Avg('resolution_time'))
        avg_hours = None
        if avg_resolution['avg']:
            avg_hours = round(avg_resolution['avg'].total_seconds() / 3600, 1)

        # AI performance
        total_tickets = tickets.count() or 1
        ai_resolved = tickets.filter(escalated=False, status__in=['RESOLVED', 'CLOSED']).count()
        escalated_count = tickets.filter(escalated=True).count()

        # SLA compliance
        active_tickets = tickets.exclude(status__in=['RESOLVED', 'CLOSED'])
        breached_count = sum(1 for t in active_tickets if t.is_sla_breached())

        # Customer satisfaction
        ratings = TicketRating.objects.all()
        avg_rating = ratings.aggregate(avg=Avg('score'))['avg']

        # Active outages
        active_outages = Outage.objects.filter(status='ACTIVE').count()

        # --- NEW: 30-day ticket volume (created per day) ---
        created_by_day = dict(
            tickets.filter(created_at__date__gte=thirty_days_ago)
            .annotate(day=TruncDate('created_at'))
            .values('day').annotate(count=Count('id'))
            .values_list('day', 'count')
        )
        # --- NEW: 30-day resolution trend (closed per day) ---
        closed_by_day = dict(
            tickets.filter(status='CLOSED', closed_at__date__gte=thirty_days_ago)
            .annotate(day=TruncDate('closed_at'))
            .values('day').annotate(count=Count('id'))
            .values_list('day', 'count')
        )
        # Fill gaps so frontend gets a continuous 30-point series
        volume_series = []
        for i in range(30):
            d = thirty_days_ago + timedelta(days=i)
            volume_series.append({
                'date': str(d),
                'created': created_by_day.get(d, 0),
                'resolved': closed_by_day.get(d, 0),
            })

        # --- NEW: per-agent workload (open + in-progress tickets) ---
        agent_workload = list(
            tickets.exclude(status__in=['RESOLVED', 'CLOSED'])
            .filter(assigned_agent__isnull=False)
            .values(
                'assigned_agent__id',
                'assigned_agent__first_name',
                'assigned_agent__last_name',
                'assigned_agent__reg_number',
            )
            .annotate(open_count=Count('id'))
            .order_by('-open_count')
        )
        # Normalize agent names
        for a in agent_workload:
            fn = a.pop('assigned_agent__first_name') or ''
            ln = a.pop('assigned_agent__last_name') or ''
            reg = a.pop('assigned_agent__reg_number') or ''
            a['agent_id'] = a.pop('assigned_agent__id')
            a['agent_name'] = (f"{fn} {ln}".strip() or reg or f"Agent {a['agent_id']}")

        daily_report = {
            'date': str(today),
            'total_today': today_tickets.count(),
            'most_common_category': list(
                today_tickets.values('category__name').annotate(count=Count('id')).order_by('-count')[:1]
            ),
            'urgent_today': list(
                today_tickets.filter(priority__in=['HIGH', 'CRITICAL'])
                .values('ticket_number', 'title', 'priority')
            ),
        }

        return Response({
            'total_tickets': total_tickets,
            'status_counts': status_counts,
            'priority_counts': priority_counts,
            'category_counts': category_counts,
            'avg_resolution_hours': avg_hours,
            'ai_resolution_rate': round((ai_resolved / total_tickets) * 100, 1),
            'ai_resolved_count': ai_resolved,
            'escalated_count': escalated_count,
            'open_tickets': status_counts.get('OPEN', 0),
            'sla_breaches': breached_count,
            'avg_satisfaction': round(avg_rating, 2) if avg_rating else None,
            'active_outages': active_outages,
            'volume_series': volume_series,        # NEW — line chart
            'agent_workload': agent_workload,      # NEW — bar chart
            'daily_report': daily_report,
        })